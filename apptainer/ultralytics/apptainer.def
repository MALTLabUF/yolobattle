Bootstrap: docker
From: ultralytics/ultralytics:latest

%environment
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/New_York
    export PATH="/usr/local/bin:${PATH}"
    export PYTHONPATH="/opt/app/src:${PYTHONPATH}"
    export DATA_ROOT="/workspace/.cache/datasets"

%files
    src   /opt/app/

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/New_York
    ln -fs /usr/share/zoneinfo/America/New_York /etc/localtime
    echo "America/New_York" > /etc/timezone
    apt-get update
    apt-get install -y --no-install-recommends tzdata fio
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip
    python -m pip install --no-cache-dir \
        pycocotools \
        imagesize \
        cloudmesh-common \
        PyYAML \
        Pillow \
        git+https://github.com/cloudmesh/cloudmesh-gpu.git

    # Use a CUDA build with Blackwell (B200) kernels.
    python -m pip install --no-cache-dir --force-reinstall \
        torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

    # Ultralytics' AMP self-check currently uses YOLO26n even when training from
    # a different YAML architecture. Bundle its small reference asset so offline
    # runs do not try writing to the immutable SIF or fetching it at startup.
    mkdir -p /ultralytics/weights
    yolo settings weights_dir=/ultralytics/weights
    # Avoid the base image's source checkout shadowing its installed Python package.
    (cd /tmp && python -c 'from pathlib import Path; from shutil import copy2; from ultralytics.utils.downloads import attempt_download_asset; p=Path(attempt_download_asset("yolo26n.pt")); expected=Path("/ultralytics/weights/yolo26n.pt"); copy2(p, expected); assert expected.is_file() and expected.stat().st_size>100_000, f"Missing AMP check asset: {expected}"')

    mkdir -p /workspace /outputs /ultralytics/.cache /workspace/.cache/datasets
    chmod -R a+rX /workspace /outputs /ultralytics
    chmod -R a+rwX /workspace /outputs /ultralytics/.cache /workspace/.cache

%runscript
    exec python -u -m yolobattle.model_training.train "$@"
